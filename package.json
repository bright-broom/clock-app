{
  "name": "clock-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": "24.x",
    "npm": ">=10.9.0 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:verify": "NEXT_PUBLIC_SITE_URL=https://clock.example next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "review:architecture": "node --test scripts/architecture-policy.test.mjs && node scripts/architecture-review.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run review:architecture && npm run type-check && npm run lint && npm run format:check && npm run test:coverage && npm run build:verify",
    "verify:ci": "npm run verify && npm run test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "critters": "^0.0.23",
    "next": "^16.3.0",
    "next-intl": "^4.13.7",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^15.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.0.0",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.2.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@parcel/watcher": {
      "picomatch": "^4.0.4"
    }
  }
}
